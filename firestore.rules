rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: Default-deny all unmatched paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Reusable Hardened Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidMovieId(id) {
      return id is string && id.size() >= 1 && id.size() <= 12 && id.matches('^[0-9]+$');
    }

    function isValidReceiptCodeId(id) {
      return id is string && id.size() >= 14 && id.size() <= 20 && id.matches('^NWC-[A-Z0-9]{4}-[A-Z0-9]{4}-[A-Z0-9]{2}$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Pure token-based bootstrapped admin check (safe for allow list — zero get()/exists())
    function isBootstrappedAdmin() {
      return isVerifiedUser() &&
        request.auth.token.email is string &&
        request.auth.token.email.lower() == 'vidushanawood@gmail.com';
    }

    function isNotBannedExisting() {
      return !('isBanned' in existing()) || existing().isBanned == false;
    }

    function isValidEpochMsOrNull(val) {
      return val == null || (val is int && val >= 1577836800000 && val <= 4102444800000);
    }

    // Validation Blueprint for UserProfile (/users/{uid})
    // Mirrors firebase-blueprint.json maxLength, enum & pattern constraints verbatim
    function isValidUserProfile(data, uid) {
      return (
        data.keys().hasAll([
          'uid',
          'email',
          'displayName',
          'emailVerified',
          'plan',
          'proActivatedAt',
          'proExpiresAt',
          'activationMethod',
          'isBanned',
          'celebrationShown',
          'createdAt'
        ]) &&
        data.keys().hasOnly([
          'uid',
          'email',
          'displayName',
          'emailVerified',
          'plan',
          'proActivatedAt',
          'proExpiresAt',
          'activationMethod',
          'paymentMethod',
          'lastOrderId',
          'isBanned',
          'celebrationShown',
          'createdAt',
          'updatedAt'
        ]) &&
        data.uid is string &&
        isValidId(data.uid) &&
        data.uid == uid &&
        data.email is string &&
        data.email.size() >= 3 &&
        data.email.size() <= 254 &&
        data.displayName is string &&
        data.displayName.size() >= 1 &&
        data.displayName.size() <= 80 &&
        data.emailVerified is bool &&
        data.emailVerified == true &&
        data.plan is string &&
        data.plan in ['free', 'pro'] &&
        isValidEpochMsOrNull(data.proActivatedAt) &&
        isValidEpochMsOrNull(data.proExpiresAt) &&
        data.activationMethod is string &&
        data.activationMethod in ['none', 'payment', 'redeem', 'admin'] &&
        (!('paymentMethod' in data) || (data.paymentMethod is string && data.paymentMethod in ['none', 'payhere_sandbox', 'payhere_live', 'redeem', 'admin'])) &&
        (!('lastOrderId' in data) || data.lastOrderId == null || (data.lastOrderId is string && isValidId(data.lastOrderId))) &&
        data.isBanned is bool &&
        data.celebrationShown is bool &&
        data.createdAt is timestamp &&
        (!('updatedAt' in data) || data.updatedAt is timestamp)
      );
    }

    // Validation Blueprint for WatchlistMovie (/users/{uid}/watchlist/{movieId})
    function isValidWatchlistMovie(data, uid, movieId) {
      return (
        data.keys().hasAll([
          'uid',
          'movieId',
          'title',
          'posterPath',
          'backdropPath',
          'releaseDate',
          'voteAverage',
          'overview',
          'addedAt'
        ]) &&
        data.keys().hasOnly([
          'uid',
          'movieId',
          'title',
          'posterPath',
          'backdropPath',
          'releaseDate',
          'voteAverage',
          'overview',
          'addedAt'
        ]) &&
        data.uid is string &&
        isValidId(data.uid) &&
        data.uid == request.auth.uid &&
        data.uid == uid &&
        data.movieId is int &&
        data.movieId >= 1 &&
        data.movieId <= 999999999 &&
        string(data.movieId) == movieId &&
        data.title is string &&
        data.title.size() >= 1 &&
        data.title.size() <= 200 &&
        data.posterPath is string &&
        data.posterPath.size() <= 300 &&
        data.backdropPath is string &&
        data.backdropPath.size() <= 300 &&
        data.releaseDate is string &&
        data.releaseDate.size() <= 20 &&
        data.voteAverage is number &&
        data.voteAverage >= 0 &&
        data.voteAverage <= 10 &&
        data.overview is string &&
        data.overview.size() <= 1200 &&
        data.addedAt is timestamp
      );
    }

    // Validation Blueprint for ReceiptEmail (/mail/{mailId})
    function isValidReceiptEmail(data, mailId) {
      return (
        data.keys().hasAll([
          'uid',
          'to',
          'transactionId',
          'planName',
          'amountPaid',
          'activationMethod',
          'activationDate',
          'expiryDate',
          'message',
          'createdAt'
        ]) &&
        data.keys().hasOnly([
          'uid',
          'to',
          'transactionId',
          'planName',
          'amountPaid',
          'activationMethod',
          'activationDate',
          'expiryDate',
          'message',
          'createdAt'
        ]) &&
        data.uid is string &&
        isValidId(data.uid) &&
        data.to is string &&
        data.to.size() >= 3 &&
        data.to.size() <= 254 &&
        data.transactionId is string &&
        isValidId(data.transactionId) &&
        data.transactionId == mailId &&
        data.planName is string &&
        data.planName.size() >= 1 &&
        data.planName.size() <= 120 &&
        data.amountPaid is string &&
        data.amountPaid.size() >= 1 &&
        data.amountPaid.size() <= 80 &&
        data.activationMethod is string &&
        data.activationMethod in ['payment', 'redeem', 'admin'] &&
        data.activationDate is string &&
        data.activationDate.size() >= 4 &&
        data.activationDate.size() <= 60 &&
        data.expiryDate is string &&
        data.expiryDate.size() >= 4 &&
        data.expiryDate.size() <= 60 &&
        data.message is map &&
        data.message.keys().hasAll(['subject', 'text', 'html']) &&
        data.message.keys().hasOnly(['subject', 'text', 'html']) &&
        data.message.subject is string &&
        data.message.subject.size() >= 1 &&
        data.message.subject.size() <= 160 &&
        data.message.text is string &&
        data.message.text.size() >= 1 &&
        data.message.text.size() <= 4000 &&
        data.message.html is string &&
        data.message.html.size() >= 1 &&
        data.message.html.size() <= 12000 &&
        data.createdAt is timestamp
      );
    }

    // Validation Blueprint for PaymentReceiptCode (/paymentReceiptCodes/{codeId})
    function isValidPaymentReceiptCode(data, codeId) {
      return (
        data.keys().hasAll([
          'code',
          'uid',
          'email',
          'phone',
          'countryName',
          'countryCode',
          'currencyCode',
          'localTotalDisplay',
          'windowIndex',
          'windowExpiresAt',
          'status',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'code',
          'uid',
          'email',
          'phone',
          'countryName',
          'countryCode',
          'currencyCode',
          'localTotalDisplay',
          'windowIndex',
          'windowExpiresAt',
          'status',
          'createdAt',
          'updatedAt',
          'submittedAt'
        ]) &&
        data.code is string &&
        isValidReceiptCodeId(data.code) &&
        data.code == codeId &&
        data.uid is string &&
        isValidId(data.uid) &&
        data.email is string &&
        data.email.size() >= 3 &&
        data.email.size() <= 254 &&
        data.phone is string &&
        data.phone.size() <= 30 &&
        data.countryName is string &&
        data.countryName.size() >= 1 &&
        data.countryName.size() <= 80 &&
        data.countryCode is string &&
        data.countryCode.size() >= 2 &&
        data.countryCode.size() <= 4 &&
        data.currencyCode is string &&
        data.currencyCode.size() >= 3 &&
        data.currencyCode.size() <= 6 &&
        data.localTotalDisplay is string &&
        data.localTotalDisplay.size() >= 1 &&
        data.localTotalDisplay.size() <= 60 &&
        data.windowIndex is int &&
        data.windowIndex >= 876576 &&
        data.windowIndex <= 2279136 &&
        data.windowExpiresAt is int &&
        data.windowExpiresAt >= 1577836800000 &&
        data.windowExpiresAt <= 4102444800000 &&
        data.status is string &&
        data.status in ['generated', 'submitted', 'used', 'expired'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp &&
        (!('submittedAt' in data) || data.submittedAt == null || data.submittedAt is timestamp)
      );
    }

    // Verified User Profiles & Freemium/Pro Subscriptions (/users/{uid})
    match /users/{uid} {
      // Owning user or bootstrapped admin may read individual profile
      allow get: if isValidId(uid) && (isBootstrappedAdmin() || (isSignedIn() && isOwner(uid)));

      // Only bootstrapped admin may list users (zero get()/exists() cost in list)
      allow list: if isBootstrappedAdmin();

      // Verified owner creates their own profile initialized strictly on the Free plan
      allow create: if isVerifiedUser() &&
        isValidId(uid) &&
        isOwner(uid) &&
        isValidUserProfile(incoming(), uid) &&
        incoming().uid == request.auth.uid &&
        request.auth.token.email is string &&
        incoming().email.lower() == request.auth.token.email.lower() &&
        incoming().plan == 'free' &&
        incoming().proActivatedAt == null &&
        incoming().proExpiresAt == null &&
        incoming().activationMethod == 'none' &&
        (!('paymentMethod' in incoming()) || incoming().paymentMethod == 'none') &&
        (!('lastOrderId' in incoming()) || incoming().lastOrderId == null) &&
        incoming().isBanned == false &&
        incoming().celebrationShown == true &&
        incoming().createdAt == request.time &&
        (!('updatedAt' in incoming()) || incoming().updatedAt == request.time);

      // Action-Based Updates: Admin management OR strictly scoped Owner actions
      allow update: if isValidId(uid) &&
        isValidUserProfile(incoming(), uid) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        (!('updatedAt' in incoming()) || incoming().updatedAt == request.time) &&
        (
          // Action 1: Bootstrapped Admin toggles Pro/Free, bans/unbans, or backfills legacy subscription fields
          (
            isBootstrappedAdmin() &&
            incoming().email == existing().email &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'plan',
              'proActivatedAt',
              'proExpiresAt',
              'activationMethod',
              'paymentMethod',
              'lastOrderId',
              'isBanned',
              'celebrationShown',
              'updatedAt'
            ])
          ) ||
          // Action 2: Verified non-banned owner performs strictly scoped self-service actions
          (
            isVerifiedUser() &&
            isOwner(uid) &&
            isNotBannedExisting() &&
            incoming().isBanned == false &&
            incoming().uid == request.auth.uid &&
            request.auth.token.email is string &&
            incoming().email.lower() == request.auth.token.email.lower() &&
            (
              // 2a: Regular profile metadata sync
              (
                incoming().diff(existing()).affectedKeys().hasOnly([
                  'displayName',
                  'email',
                  'emailVerified',
                  'updatedAt'
                ])
              ) ||
              // 2b: One-time legacy profile backfill to Free defaults
              (
                !('plan' in existing()) &&
                incoming().plan == 'free' &&
                incoming().proActivatedAt == null &&
                incoming().proExpiresAt == null &&
                incoming().activationMethod == 'none' &&
                incoming().celebrationShown == true &&
                incoming().diff(existing()).affectedKeys().hasOnly([
                  'displayName',
                  'email',
                  'emailVerified',
                  'plan',
                  'proActivatedAt',
                  'proExpiresAt',
                  'activationMethod',
                  'paymentMethod',
                  'lastOrderId',
                  'isBanned',
                  'celebrationShown',
                  'updatedAt'
                ])
              ) ||
              // 2c: Owner Pro activation via PayHere Payment or Redeem Code (strictly capped at 31 days max)
              (
                incoming().plan == 'pro' &&
                incoming().activationMethod in ['payment', 'redeem'] &&
                (!('paymentMethod' in incoming()) || (
                  (incoming().activationMethod == 'payment' && incoming().paymentMethod in ['payhere_sandbox', 'payhere_live']) ||
                  (incoming().activationMethod == 'redeem' && incoming().paymentMethod == 'redeem')
                )) &&
                incoming().proActivatedAt is int &&
                incoming().proExpiresAt is int &&
                incoming().proExpiresAt > incoming().proActivatedAt &&
                incoming().proExpiresAt - incoming().proActivatedAt <= 2678400000 &&
                incoming().proExpiresAt <= request.time.toMillis() + 2678400000 &&
                incoming().diff(existing()).affectedKeys().hasOnly([
                  'plan',
                  'proActivatedAt',
                  'proExpiresAt',
                  'activationMethod',
                  'paymentMethod',
                  'lastOrderId',
                  'isBanned',
                  'celebrationShown',
                  'updatedAt'
                ])
              ) ||
              // 2d: Automatic 30-day expiry downgrade to Free
              (
                incoming().plan == 'free' &&
                incoming().proExpiresAt == null &&
                incoming().diff(existing()).affectedKeys().hasOnly([
                  'plan',
                  'proExpiresAt',
                  'updatedAt'
                ])
              ) ||
              // 2e: Mark Neon Fire celebration as shown
              (
                incoming().celebrationShown == true &&
                incoming().diff(existing()).affectedKeys().hasOnly([
                  'celebrationShown',
                  'updatedAt'
                ])
              )
            )
          )
        );

      // Bootstrapped Admin or verified owner may delete profile document
      allow delete: if isValidId(uid) && (isBootstrappedAdmin() || (isVerifiedUser() && isOwner(uid)));

      // Synced Movie Watchlist Subcollection (/users/{uid}/watchlist/{movieId})
      match /watchlist/{movieId} {
        allow get: if isSignedIn() && isValidId(uid) && isValidMovieId(movieId) && isOwner(uid);
        allow list: if isSignedIn() && isOwner(uid) && resource.data.uid == request.auth.uid;

        allow create: if isVerifiedUser() &&
          isValidId(uid) &&
          isValidMovieId(movieId) &&
          isOwner(uid) &&
          isValidWatchlistMovie(incoming(), uid, movieId) &&
          incoming().addedAt == request.time &&
          exists(/databases/$(database)/documents/users/$(uid));

        allow update: if isVerifiedUser() &&
          isValidId(uid) &&
          isValidMovieId(movieId) &&
          isOwner(uid) &&
          isValidWatchlistMovie(incoming(), uid, movieId) &&
          incoming().uid == existing().uid &&
          incoming().movieId == existing().movieId &&
          incoming().addedAt == existing().addedAt &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'title',
            'posterPath',
            'backdropPath',
            'releaseDate',
            'voteAverage',
            'overview'
          ]) &&
          exists(/databases/$(database)/documents/users/$(uid));

        allow delete: if isVerifiedUser() && isValidId(uid) && isValidMovieId(movieId) && isOwner(uid);
      }
    }

    // Immutable Activation Receipt Queue (/mail/{mailId}) for Firebase Trigger Email Extension
    match /mail/{mailId} {
      allow get: if isValidId(mailId) && (isBootstrappedAdmin() || (isSignedIn() && existing().uid == request.auth.uid));
      allow list: if isBootstrappedAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);

      allow create: if isValidId(mailId) &&
        isValidReceiptEmail(incoming(), mailId) &&
        incoming().createdAt == request.time &&
        (
          isBootstrappedAdmin() ||
          (
            isVerifiedUser() &&
            incoming().uid == request.auth.uid &&
            request.auth.token.email is string &&
            incoming().to.lower() == request.auth.token.email.lower() &&
            exists(/databases/$(database)/documents/users/$(request.auth.uid))
          )
        );

      // Receipts are strictly immutable audit records
      allow update, delete: if false;
    }

    // 30-Minute Rotating Unique Payment Receipt Codes (/paymentReceiptCodes/{codeId})
    // Keyed by exact unique codeId to enforce global anti-reuse uniqueness across all users
    match /paymentReceiptCodes/{codeId} {
      // Strictly isolated PII (email/phone): only owning user or bootstrapped admin may read
      allow get: if isValidReceiptCodeId(codeId) && (isBootstrappedAdmin() || (isSignedIn() && existing().uid == request.auth.uid));
      allow list: if isBootstrappedAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);

      // Verified user records their newly generated/submitted 30-minute unique code (cannot overwrite existing code)
      allow create: if isVerifiedUser() &&
        isValidReceiptCodeId(codeId) &&
        isValidPaymentReceiptCode(incoming(), codeId) &&
        incoming().uid == request.auth.uid &&
        request.auth.token.email is string &&
        incoming().email.lower() == request.auth.token.email.lower() &&
        incoming().status in ['generated', 'submitted'] &&
        incoming().windowExpiresAt <= request.time.toMillis() + 3600000 &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        (!('submittedAt' in incoming()) || incoming().submittedAt == null || incoming().submittedAt == request.time) &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));

      // Action-Based Updates with Terminal State Locking ('used' and 'expired' are locked against owner changes)
      allow update: if isValidReceiptCodeId(codeId) &&
        isValidPaymentReceiptCode(incoming(), codeId) &&
        incoming().code == existing().code &&
        incoming().uid == existing().uid &&
        incoming().email == existing().email &&
        incoming().windowIndex == existing().windowIndex &&
        incoming().windowExpiresAt == existing().windowExpiresAt &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          // Action 1: Bootstrapped Admin marks a receipt code as used, expired, or resets state
          (
            isBootstrappedAdmin() &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'status',
              'updatedAt'
            ])
          ) ||
          // Action 2: Verified owner submits their active (non-terminal) receipt code via WhatsApp
          (
            isVerifiedUser() &&
            existing().uid == request.auth.uid &&
            existing().status in ['generated', 'submitted'] &&
            incoming().status == 'submitted' &&
            (!('submittedAt' in incoming()) || incoming().submittedAt == request.time) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'phone',
              'countryName',
              'countryCode',
              'currencyCode',
              'localTotalDisplay',
              'status',
              'submittedAt',
              'updatedAt'
            ])
          )
        );

      // Only bootstrapped admin may remove receipt code records (owners cannot erase anti-reuse history)
      allow delete: if isValidReceiptCodeId(codeId) && isBootstrappedAdmin();
    }
  }
}
