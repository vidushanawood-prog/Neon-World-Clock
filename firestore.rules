rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: Default-deny all unmatched paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Reusable Hardened Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidMovieId(id) {
      return id is string && id.size() >= 1 && id.size() <= 12 && id.matches('^[0-9]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Validation Blueprint for UserProfile (/users/{uid})
    // Mirrors firebase-blueprint.json maxLength & pattern constraints verbatim
    function isValidUserProfile(data, uid) {
      return (
        data.keys().hasAll(['uid', 'email', 'displayName', 'emailVerified', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'email', 'displayName', 'emailVerified', 'createdAt', 'updatedAt']) &&
        data.uid is string &&
        isValidId(data.uid) &&
        data.uid == request.auth.uid &&
        data.uid == uid &&
        data.email is string &&
        data.email.size() >= 3 &&
        data.email.size() <= 254 &&
        request.auth.token.email is string &&
        data.email.lower() == request.auth.token.email.lower() &&
        data.displayName is string &&
        data.displayName.size() >= 1 &&
        data.displayName.size() <= 80 &&
        data.emailVerified is bool &&
        data.emailVerified == true &&
        data.createdAt is timestamp &&
        (!('updatedAt' in data) || data.updatedAt is timestamp)
      );
    }

    // Validation Blueprint for WatchlistMovie (/users/{uid}/watchlist/{movieId})
    // Mirrors firebase-blueprint.json constraints verbatim
    function isValidWatchlistMovie(data, uid, movieId) {
      return (
        data.keys().hasAll([
          'uid',
          'movieId',
          'title',
          'posterPath',
          'backdropPath',
          'releaseDate',
          'voteAverage',
          'overview',
          'addedAt'
        ]) &&
        data.keys().hasOnly([
          'uid',
          'movieId',
          'title',
          'posterPath',
          'backdropPath',
          'releaseDate',
          'voteAverage',
          'overview',
          'addedAt'
        ]) &&
        data.uid is string &&
        isValidId(data.uid) &&
        data.uid == request.auth.uid &&
        data.uid == uid &&
        data.movieId is int &&
        data.movieId >= 1 &&
        data.movieId <= 999999999 &&
        string(data.movieId) == movieId &&
        data.title is string &&
        data.title.size() >= 1 &&
        data.title.size() <= 200 &&
        data.posterPath is string &&
        data.posterPath.size() <= 300 &&
        data.backdropPath is string &&
        data.backdropPath.size() <= 300 &&
        data.releaseDate is string &&
        data.releaseDate.size() <= 20 &&
        data.voteAverage is number &&
        data.voteAverage >= 0 &&
        data.voteAverage <= 10 &&
        data.overview is string &&
        data.overview.size() <= 1200 &&
        data.addedAt is timestamp
      );
    }

    // Verified User Profiles (PII strictly isolated to document owner)
    match /users/{uid} {
      // Only the owning authenticated user can read their own profile
      allow get: if isSignedIn() && isValidId(uid) && isOwner(uid);

      // Never allow scraping/listing user emails or profiles
      allow list: if false;

      // Only verified owner may create their own profile with server timestamp & strict schema
      allow create: if isVerifiedUser() &&
        isValidId(uid) &&
        isOwner(uid) &&
        isValidUserProfile(incoming(), uid) &&
        incoming().createdAt == request.time &&
        (!('updatedAt' in incoming()) || incoming().updatedAt == request.time);

      // Action-Based Update: Verified owner may update displayName / synced email / updatedAt only; uid & createdAt immutable
      allow update: if isVerifiedUser() &&
        isValidId(uid) &&
        isOwner(uid) &&
        isValidUserProfile(incoming(), uid) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        (
          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'emailVerified', 'updatedAt']) &&
          (!('updatedAt' in incoming()) || incoming().updatedAt == request.time)
        );

      // Verified owner may delete their own profile document
      allow delete: if isVerifiedUser() && isValidId(uid) && isOwner(uid);

      // Synced Movie Watchlist Subcollection (/users/{uid}/watchlist/{movieId})
      match /watchlist/{movieId} {
        // Owner-only single-document read
        allow get: if isSignedIn() && isValidId(uid) && isValidMovieId(movieId) && isOwner(uid);

        // Owner-only list query enforced via resource.data.uid (zero get()/exists() cost in list)
        allow list: if isSignedIn() && isOwner(uid) && resource.data.uid == request.auth.uid;

        // Verified owner may add a movie if parent profile exists (Master Gate), schema & timestamp match
        allow create: if isVerifiedUser() &&
          isValidId(uid) &&
          isValidMovieId(movieId) &&
          isOwner(uid) &&
          isValidWatchlistMovie(incoming(), uid, movieId) &&
          incoming().addedAt == request.time &&
          exists(/databases/$(database)/documents/users/$(uid));

        // Action-Based Update: Verified owner may refresh cached TMDB metadata only; uid, movieId & addedAt immutable
        allow update: if isVerifiedUser() &&
          isValidId(uid) &&
          isValidMovieId(movieId) &&
          isOwner(uid) &&
          isValidWatchlistMovie(incoming(), uid, movieId) &&
          incoming().uid == existing().uid &&
          incoming().movieId == existing().movieId &&
          incoming().addedAt == existing().addedAt &&
          incoming().diff(existing()).affectedKeys().hasOnly(['title', 'posterPath', 'backdropPath', 'releaseDate', 'voteAverage', 'overview']) &&
          exists(/databases/$(database)/documents/users/$(uid));

        // Verified owner may remove a movie from their own watchlist
        allow delete: if isVerifiedUser() && isValidId(uid) && isValidMovieId(movieId) && isOwner(uid);
      }
    }
  }
}
